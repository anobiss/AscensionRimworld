<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>AS_Apparel_SectUniform</defName>
    <label>sect uniform</label>
    <description>A sect uniform used by cultivators. Provides 0.5-2x Cultivation Speed, 0.5-2x Foundation Training Speed and 0.5-2x Qi Recovery Speed to cultivators depending on quality.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/SectUniform/SectUniform</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costStuffCount>70</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToMake>7000</WorkToMake>
      <Mass>0.75</Mass>
      <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.4</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.4</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/SectUniform/SectUniform</wornGraphicPath>
      <layers>
        <li>Shell</li>
      </layers>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
      <canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
      <tags>
        <li>Robe</li>
      </tags>
    </apparel>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
    <possessionCount>1</possessionCount>
    <tradeTags>
      <li>BasicClothing</li>
    </tradeTags>
    <recipeMaker>
      <displayPriority>240</displayPriority>
    </recipeMaker>
	<comps>
	  <li Class="Ascension.CompProperties_CultivationUniform">
		<qiRecSpeedOffset>1</qiRecSpeedOffset>
        <cultSpeedOffset>1</cultSpeedOffset>
        <fTrainingOffset>1</fTrainingOffset>
      </li>
    </comps>
  </ThingDef>
</Defs>