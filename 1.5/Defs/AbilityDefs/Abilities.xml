  <AbilityDef ParentName="AbilityTouchBase">
    <defName>QiResurrection</defName>
    <label>qi resurrect</label>
    <description>Use a massive amount of qi to infuse a corpse's body with new life, repairing degenerated cell structures and kickstarting vital functions. The older and worse-preserved the corpse is, the more likely it is that they will come back with memory loss or health conditions. This ability seems to clog the qi pathways used in it somehow, so it can only be used once every 3 days.</description>
    <iconPath>UI/Abilities/QiResurrection</iconPath>
	<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <cooldownTicksRange>180000</cooldownTicksRange> <!-- 3 days -->
    <warmupMote>Mote_QiMistStencil</warmupMote>
    <warmupEffecter>QiMist</warmupEffecter>
    <warmupStartSound>QiHeal_Cast</warmupStartSound>
    <category>QiTechnique</category>
    <displayOrder>600</displayOrder>
    <hostile>false</hostile>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>Verb_CastAbilityTouch</verbClass>
      <drawAimPie>false</drawAimPie>
      <range>-1</range>
      <warmupTime>120</warmupTime>
      <soundCast>QiHeal_Cast</soundCast>
	  <ai_IsWeapon>false</ai_IsWeapon>
      <targetParams>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetCorpses>true</canTargetCorpses>
        <canTargetMechs>false</canTargetMechs>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_Resurrect" />
      <li Class="Ascension.CompProperties_AbilityQiCost">
        <cost>10000000</cost>
      </li>
    </comps>
  </AbilityDef>
  
